---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME } from "@consts";
import profilePhoto from "../assets/Profile.jpg";

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16">
      <section>
        <div class="flex flex-col md:flex-row md:items-start md:gap-8">
          <Image
            src={profilePhoto}
            alt="Pedro Marin Sekine"
            width={320}
            height={320}
            class="animate rounded-2xl w-32 h-32 md:w-40 md:h-40 object-cover mx-auto md:mx-0 mb-6 md:mb-0 shrink-0"
          />
          <div class="space-y-4">
            <p class="animate">
              I work at the intersection of <strong>design, technology, and communication</strong>. Not the world's best at any one of them — but the combination is where interesting things happen.
            </p>
            <p class="animate">
              Most recently Global Product Manager at Lenzing. I've just completed an MSc in Innovation and Product Management at FH Upper Austria, with a thesis on designing consumer electronics that last, and I'm now in a second Master's, in Interdisciplinary Computing at IT:U in Linz.
            </p>
          </div>
        </div>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Recent projects
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

    </div>
  </Container>
</PageLayout>
