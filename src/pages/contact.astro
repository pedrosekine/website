---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { CONTACT, SOCIALS } from "@consts";
---

<PageLayout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Contact
      </div>
      <article class="animate space-y-4">
        <p>
          Want to collaborate, chat, or say hello? Reach out through any of the channels below.
        </p>
        <ul class="space-y-2">
          {SOCIALS.map(social => (
            <li>
              <Link href={social.HREF} external>
                {social.NAME}
              </Link>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </Container>
</PageLayout>
